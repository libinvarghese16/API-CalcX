# Optional build-specific overrides for the committed public Firebase Web app
# identification. Firebase authorization remains controlled by Authentication,
# authorized domains, and backend security rules rather than these public values.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_MEASUREMENT_ID=

# Set to true only after google-services.json / GoogleService-Info.plist and
# the matching provider configuration have been added to the native projects.
VITE_NATIVE_FIREBASE_AUTH_ENABLED=false
