{
  "name": "@api-calc-pro/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4310",
    "build": "tsc -b && vite build && node tools/generate-precache.mjs",
    "native:sync": "npm run build && cap sync && npm run android:verify-assets",
    "android:sync": "npm run build && cap sync android && npm run android:verify-assets",
    "android:verify-assets": "node tools/verify-native-assets.mjs",
    "android:build-debug": "npm run android:sync && powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-android-debug.ps1",
    "android:verify-apk": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify-debug-apk.ps1",
    "android:instrumented-test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-android-instrumented-test.ps1",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@api-calc-pro/calc-engine": "*",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.6",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
